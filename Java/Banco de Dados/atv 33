DELIMITER $$

CREATE FUNCTION fn_CalcularAtraso(id_emprestimo INT)
RETURNS INT
DETERMINISTIC
BEGIN

    DECLARE dias_atraso INT;

    SELECT
        DATEDIFF(
            COALESCE(data_devolucao, CURRENT_DATE),
            data_prevista
        )
    INTO dias_atraso
    FROM emprestimo
    WHERE emprestimo.id_emprestimo = id_emprestimo;

    RETURN GREATEST(dias_atraso, 0);

END $$

DELIMITER ;


