-- 1. EMPRÉSTIMOS REALIZADOS
-- INNER JOIN
-- Lista o nome do leitor, título do livro
-- e data do empréstimo.

SELECT
    l.nome,
    li.titulo,
    e.data_emprestimo
FROM emprestimo e
INNER JOIN leitores l
    ON e.id_leitores = l.id_leitores
INNER JOIN livro li
    ON e.id_livros = li.id_livros;


-- ============================================
-- 2. TODOS OS LEITORES E SEUS EMPRÉSTIMOS
-- LEFT JOIN
-- ============================================

SELECT
    l.nome,
    li.titulo
FROM leitores l
LEFT JOIN emprestimo e
    ON l.id_leitores = e.id_leitores
LEFT JOIN livro li
    ON e.id_livros = li.id_livros;


-- ============================================
-- 3. LIVROS PENDENTES DE DEVOLUÇÃO
-- WHERE + JOIN
-- ============================================

SELECT
    l.nome,
    li.titulo,
    e.data_prevista
FROM emprestimo e
INNER JOIN leitores l
    ON e.id_leitores = l.id_leitores
INNER JOIN livro li
    ON e.id_livros = li.id_livros
WHERE e.data_devolucao IS NULL;


