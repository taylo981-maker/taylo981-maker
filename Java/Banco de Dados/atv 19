import java.util.Scanner;

public class Exercicio11 {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        int somaPares = 0;
        int somaImpares = 0;
        int quantidadeImpares = 0;

        for (int i = 1; i <= 10; i++) {
            System.out.print("Digite o " + i + "º número: ");
            int numero = scanner.nextInt();

            if (numero % 2 == 0) {
                somaPares += numero;
            } else {
                somaImpares += numero;
                quantidadeImpares++;
            }
        }

        System.out.println("\nSoma dos números pares: " + somaPares);

        if (quantidadeImpares > 0) {
            double mediaImpares = (double) somaImpares / quantidadeImpares;
            System.out.println("Média dos números ímpares: " + mediaImpares);
        } else {
            System.out.println("Nenhum número ímpar foi digitado.");
        }

        scanner.close();
    }
}
