import java.util.Scanner; // 1. Importa a classe Scanner

public class Principal {
    public static void main(String[] args) {
        // 2. cria o objeto Scanner para ler o teclado
        Scanner scanner = new Scanner(System.in);

        // 3. pede e lê o nome (texto)
        System.out.print("Digite o seu nome: ");
        String nome = scanner.nextLine();

        // 4. pede e lê a idade (número inteiro)
        System.out.print("Digite a sua idade: ");
        int idade = scanner.nextInt();

        // 5. mostra o resultado na tela
        System.out.println("olá, " + nome + "! você tem " + idade + " anos.");

        // fecha o scanner para liberar o recurso
        scanner.close();
    }
}
