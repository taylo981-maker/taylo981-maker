SELECT cliente.nome, estado.nome
FROM cliente
INNER JOIN endereco
ON cliente.id_Endereco = endereco.id_Endereco
INNER JOIN cidade
ON endereco.id_Cidade = cidade.id_Cidade
INNER JOIN estado
ON cidade.id_Estado = estado.id_Estado;

SELECT cidade.nome, estado.nome
FROM cidade
INNER JOIN estado
ON cidade.id_Estado = estado.id_Estado;

SELECT estado.nome, pais.nome
FROM estado
INNER JOIN pais
ON estado.id_Pais = pais.id_Pais;

SELECT cliente.nome, pais.nome
FROM cliente
INNER JOIN endereco
ON cliente.id_Endereco = endereco.id_Endereco
INNER JOIN cidade
ON endereco.id_Cidade = cidade.id_Cidade
INNER JOIN estado
ON cidade.id_Estado = estado.id_Estado
INNER JOIN pais
ON estado.id_Pais = pais.id_Pais;

SELECT cliente.nome, cidade.nome, estado.nome, pais.nome
FROM cliente
INNER JOIN endereco
ON cliente.id_Endereco = endereco.id_Endereco
INNER JOIN cidade
ON endereco.id_Cidade = cidade.id_Cidade
INNER JOIN estado
ON cidade.id_Estado = estado.id_Estado
INNER JOIN pais
ON estado.id_Pais = pais.id_Pais;
