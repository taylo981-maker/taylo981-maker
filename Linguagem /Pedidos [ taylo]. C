#include <stdio.h>

void bubbleSort(int v[], int n)
{
    int i, j, aux;

    for(i = 0; i < n - 1; i++)
    {
        for(j = 0; j < n - 1; j++)
        {
            if(v[j] > v[j + 1])
            {
                aux = v[j];
                v[j] = v[j + 1];
                v[j + 1] = aux;
            }
        }
    }
}

int buscaBinaria(int v[], int n, int x)
{
    int inicio = 0, fim = n - 1, meio;

    while(inicio <= fim)
    {
        meio = (inicio + fim) / 2;

        if(v[meio] == x)
            return meio;

        if(x < v[meio])
            fim = meio - 1;
        else
            inicio = meio + 1;
    }

    return -1;
}

int main()
{
    int pedidos[8] = {47, 12, 83, 5, 29, 61, 74, 38};
    int i, pedido, posicao;
    int buscas = 0;

    printf("Pedidos recebidos:\n");
    for(i = 0; i < 8; i++)
    {
        printf("%d ", pedidos[i]);
    }

    bubbleSort(pedidos, 8);

    printf("\n\nPedidos ordenados:\n");
    for(i = 0; i < 8; i++)
    {
        printf("%d ", pedidos[i]);
    }

    while(1)
    {
        printf("\n\nDigite um pedido (0 para sair): ");
        scanf("%d", &pedido);

        if(pedido == 0)
            break;

        buscas++;

        posicao = buscaBinaria(pedidos, 8, pedido);

        if(posicao != -1)
            printf("Encontrado na posicao %d\n", posicao);
        else
            printf("Pedido nao encontrado\n");
    }

    printf("\n%d busca(s) realizada(s).\n", buscas);

    return 0;
}
