DROP DATABASE IF EXISTS VETERINARIA;

CREATE DATABASE VETERINARIA;

USE VETERINARIA;

CREATE TABLE raça (
    id_Animal INT PRIMARY KEY AUTO_INCREMENT,
    nome VARCHAR(100),
    especie VARCHAR(50),
    idade INT
);

